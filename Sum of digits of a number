import java.util.*;

class Main {
    public static void main(String[] args) {
        
        Scanner sc = new Scanner(System.in);
        System.out.println("Enter the number to find the sum of digits");
        int num = sc.nextInt();
       
        int sum = 0;
      
          num = Math.abs(num);
          
          while (num>0){
            sum = sum + num%10;
            num = num/10;
          }
          
          
        
        System.out.println("The sum of digits is " + sum);
    }
}
