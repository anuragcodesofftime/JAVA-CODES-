// the whole game is what you assign nsp and nst and how u increment or decrement them... with this you can print any star pattern its just the space and stars game





package main;
import java.util.Scanner;

public class pattern{
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();   // number of rows
        int nsp = n-1;
        int nst = n;
       
        for(int i = 1 ; i <= n ; i++) {
        	
        	for(int j = 1 ; j <= nsp ;j++) {
        		System.out.print(" ");
        	}
        	
        	for(int j = 1; j <= nst ; j++) {
        		System.out.print("*");
        	}
        	
        	nsp = nsp-1;
//        	nst = nst+1;
        	
        	System.out.println();
        }
        
        

        sc.close();
    }
}
